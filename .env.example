# ─── Runner Radar configuration ───────────────────────────────────────
# Copy to .env and fill in. Never commit .env.

# Public URL of the app. Must be https:// in production (cookies are Secure-only).
# On Render this is filled in automatically; set it only if you add a custom domain.
APP_URL=http://localhost:8787
PORT=8787
# NODE_ENV=production
# Number of reverse proxies in front of the app (Render, Fly, Nginx… = 1). Defaults to 1 on Render.
TRUST_PROXY=0
DB_PATH=data/radar.db

# ─── Sign-in (OAuth). Enable any or all. ─────────────────────────────
# Redirect URI to register with each provider:  {APP_URL}/auth/{google|discord|x}/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
# Your sign-in email(s), comma separated. These accounts get the Admin dashboard, and if they
# link Telegram they also get owner alerts (crashes, pump.fun feed down, trade budget used up).
ADMIN_EMAILS=
# Local only: one-click "dev" account. Ignored when NODE_ENV=production.
ALLOW_DEV_LOGIN=0

# ─── Market data ──────────────────────────────────────────────────────
# Solana RPC with a free/paid key (Helius, Triton, QuickNode, Alchemy…). Enables
# the contract auditor, honeypot checks and funder tracing. Without it those show "pending".
SOLANA_RPC_URL=
RPC_MAX_RPS=8
# 2 extra RPC calls per new deployer to find who funded it (catches recycled rug wallets).
ENABLE_FUNDER_TRACE=0
# PumpPortal real-time pump.fun feed. New launches + graduations are free with no key.
# Live TRADES (bundles, snipers, holders, momentum, tracked wallets) need an API key and are
# billed per event from the key's linked wallet (0.01 SOL per 10,000 events at time of writing).
# WARNING: anyone with this key can trade that wallet's funds. Keep only a small balance in it,
# never commit it, and store it only as a server secret.
PUMPPORTAL_API_KEY=
# Daily event budget (50,000 ≈ 0.05 SOL/day). Spending is paced evenly across the UTC day;
# runners and watched tokens are covered first. Lower it to spend less.
FEED_DAILY_EVENTS=50000
# FEED_MAX_SUBS=150          tokens streaming at once
# FEED_TRIAL_MS=30000        every launch is streamed this long, then kept only with traction
# FEED_TRACTION_BUYERS=6     unique buyers needed during the trial to stay subscribed
# FEED_COOL_MS=180000        drop a token's stream after this long with no trades
ENABLE_DEXSCREENER=1
# Jupiter (free, no key) for SOL price and post-graduation sell quotes.
ENABLE_JUPITER=1
IPFS_GATEWAY=https://ipfs.io/ipfs/

# Wallets everyone's Smart money agent tracks (comma separated). Users add their own in-app.
SMART_WALLETS=

# ─── Jev scam judge (TypeSafe AI, optional) ───────────────────────────
# Jev is TypeSafe's System One decision model, called through their official SDK
# (@typesafe-ai/sdk). It gives each promising token a scam probability, a risk level and
# a launch pattern, and blocks it at JEV_BLOCK_AT. Get a key at https://console.typesafe.ai
# ≈ $0.042 per million input tokens, output free: about $0.00005 per token judged.
TYPESAFE_API_KEY=
# JEV_MODEL=jev-1.13.0       pinned version (jev-latest moves when TypeSafe ships a new one)
# JEV_MIN_SCORE=55           only judge tokens at this Runner Score or higher
# JEV_WARN_AT=0.6            scam probability that shows a warning
# JEV_BLOCK_AT=0.9           scam probability that blocks the token for everyone
# JEV_RECHECK_MS=600000      re-judge a token at most every 10 minutes
# JEV_DAILY_CALLS=5000       hard daily cap (5,000 ≈ $0.25/day at most)
# TYPESAFE_BASE_URL=         only to route through a gateway (Vercel AI Gateway, OpenRouter…)

# ─── Billing (Stripe, optional) ───────────────────────────────────────
# Set only the secret key: products, monthly prices and the webhook are created
# automatically on boot (the webhook signing secret is stored in the database).
# Without a key, everything runs on the free tier; in DEMO mode checkout is simulated.
STRIPE_SECRET_KEY=
# Only needed if you created the webhook yourself in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=
# Monthly prices in whole USD. Changing them creates new Stripe prices automatically.
PRICE_PRO_USD=29
PRICE_APEX_USD=79

# ─── Alerts ───────────────────────────────────────────────────────────
# Create a bot with @BotFather, paste the token and the bot's username (without @).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# ─── Tuning (defaults are sensible) ───────────────────────────────────
# MAX_WATCHED=1500          tokens kept in memory and subscribed
# AUDIT_AFTER_BUYS=5        buys before RPC checks are spent on a token
# RUNNER_SCORE=80           score needed to be promoted to RUNNER
# BUNDLE_WINDOW_MS=2000     launch window for bundle detection
# SNIPER_WINDOW_MS=5000
# MIN_HOLDERS_FOR_CONCENTRATION=30
